# Copy to .env for local use (never commit .env). Every setting is optional locally;
# on the live site set them in Render (service > Environment). docs/operator-runbook.md has the full table.

# --- Login (set both on any public site: every search can spend the API keys) ---
# The name and password for the login page (case-sensitive).
APP_USERNAME=
APP_PASSWORD=
# Signs the login cookie; by default derived from the login. Changing it logs everyone out.
SECRET_KEY=

# --- Data ---
# The permanent Postgres database (saved leads, marks, calls, searches, the Yelp count).
# Leave empty locally to use a SQLite file in the cache folder.
DATABASE_URL=
# Folder for the API response cache and the local SQLite database.
LEADGEN_CACHE_DIR=.cache

# --- Sources (both optional: without a key only the free OpenStreetMap data is used) ---
# Google: create a key at https://console.cloud.google.com/ and enable "Places API (New)".
GOOGLE_PLACES_API_KEY=
# Yelp: the "API Key" (not the Client ID) at https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# --- Emergency switches (1 = on; remove or set to 0 to switch off) ---
# Find leads refuses to start.
LEADGEN_SEARCH_PAUSED=
# Stop every Google call (no Google charges) / every Yelp call; other sources keep working.
LEADGEN_GOOGLE_OFF=
LEADGEN_YELP_OFF=

# --- Telling someone about problems ---
# An https incoming-webhook address (Slack, Microsoft Teams, Google Chat or Discord) that
# gets a short message for every failed or incomplete search and every server error.
LEADGEN_ALERT_WEBHOOK=
# Whom the login page names for access or a forgotten password: a name plus a phone number
# or email, e.g. Jane Doe at (801) 555-0100 or jane@example.com (empty: "Ask the person who
# gave you your login, or Wright AI Solutions.")
LEADGEN_SUPPORT_CONTACT=
# Without a password: extra host names the page answers on (comma separated).
LEADGEN_ALLOWED_HOSTS=
